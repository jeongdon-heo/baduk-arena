# Firebase web app credentials.
# Copy this file to ".env.local" and fill in values from Firebase console:
#   https://console.firebase.google.com/  →  Project settings  →  Your apps  →  Web app
#
# These are NOT secrets in the traditional sense (they're embedded in the
# client bundle), but you should still scope them via Firebase Security Rules.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
